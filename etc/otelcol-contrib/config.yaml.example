# /etc/otelcol-contrib/config.yaml
receivers:
  filelog/nats:
    include: [/var/log/nats/nats-server.log]
    start_at: end
  prometheus:
    config:
      scrape_configs:
        - job_name: nats
          scrape_interval: 30s
          static_configs:
            - targets: ["127.0.0.1:7777"]

processors:
  batch:
    timeout: 5s

exporters:
  otlphttp/openobserve:
    endpoint: https://<OpenObserve 地址>/api/<组织>
    headers:
      Authorization: Basic <令牌>
      stream-name: nats

service:
  pipelines:
    metrics:
      receivers: [prometheus]
      processors: [batch]
      exporters: [otlphttp/openobserve]
    logs:
      receivers: [filelog/nats]
      processors: [batch]
      exporters: [otlphttp/openobserve]
