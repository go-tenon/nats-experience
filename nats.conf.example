# 复制为 nats.conf。账号和用户由 nsc 管理，见 docs/02-accounts.md。
server_name: nats-1                 # 热加载时不能修改

# 访问来源由云平台安全组控制
listen: 0.0.0.0:4222
# 监控，仅本机
http: 127.0.0.1:8222

jetstream {
  store_dir: /data
  # 每秒同步磁盘，断电最多丢约 1 秒的写入
  sync_interval: "1s"
  # 所有账号合计的磁盘上限
  max_file_store: 30GB
  max_memory_store: 256MB
}

# 运营者、系统账号和账号 resolver，由 nsc generate config 生成，见 docs/01-deploy.md
include resolver.conf
