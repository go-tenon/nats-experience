# 配置模板，install-nats.sh 按此结构生成。<...> 为占位符，哈希用 `nats server passwd` 生成。
server_name: nats-1

# 只监听内网；公网访问由安全组和 ufw 限制
listen: <内网 IP>:4222
# 监控，仅本机
http: 127.0.0.1:8222

jetstream {
  store_dir: /data
  # 每秒同步磁盘，断电最多丢约 1 秒的写入
  sync_interval: "1s"
  # 各账号 max_file 之和不超过此值
  max_file_store: 30GB
  max_memory_store: 256MB
}

# 每个产品一个账号。修改后 docker kill -s HUP nats
accounts {
  PRODUCT_A: {
    jetstream: { max_file: 5GB, max_mem: 64MB, max_streams: 20, max_consumers: 200 }
    users: [ { user: product_a, password: "<bcrypt 哈希>" } ]
  }
  PRODUCT_B: {
    jetstream: { max_file: 5GB, max_mem: 64MB, max_streams: 20, max_consumers: 200 }
    users: [ { user: product_b, password: "<bcrypt 哈希>" } ]
  }
  # 运维账号，不给应用用
  SYS: {
    users: [ { user: sys, password: "<bcrypt 哈希>" } ]
  }
}
system_account: SYS
