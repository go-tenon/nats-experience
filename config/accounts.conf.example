# 复制为 accounts.conf。每个产品一个账号，账号之间 subject、stream 互相隔离。
# 用户名在所有账号中唯一。修改后执行 docker compose kill -s HUP nats 生效，见 docs/01-accounts.md。

system_account: SYS

accounts {
  # 系统账号：查看服务器状态（nats server report）
  SYS {
    users = [
      { user: admin, password: "CHANGE_ME" }
    ]
  }

  PRODUCT_A {
    jetstream: enabled
    users = [
      { user: product_a, password: "CHANGE_ME" }
    ]
  }
}
